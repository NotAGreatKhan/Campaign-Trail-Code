                if (state == 21329) {return 0.25} // North West England
                if (state == 21350) {return 0.33} // Yorkshire
                if (state == 21413) {return 0.3} // East of England
                if (state == 21371) {return 0.35} // East Midlands
                if (state == 21392) {return 0.3} // West Midlands
                if (state == 21518) {return 0.3} // Scotland
               
                // Conservative thresholds
