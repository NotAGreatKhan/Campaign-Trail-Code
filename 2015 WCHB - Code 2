    },
    {
        "model": "campaign_trail.answer_feedback",
        "pk": 2526,
        "fields": {
            "answer": 5020,
            "candidate": 200,
            "answer_feedback": "It’s expected this manifesto will be a rather jack of all trades sort of manuscript. It’s unlikely it will reach far with any specific group, but may keep a wide array of different voter factions mildly contented."
