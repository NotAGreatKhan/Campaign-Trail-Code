campaignTrail_temp.questions_json = [ { "model": "campaign_trail.question", "pk": 1000, "fields": { "priority": 1, "description": "19th April 2017 - Mrs Prime Minister, we are at a standstill. Increased factionalism in the Conservative party plus only having Cameron’s narrow 2015 majority to work with has led to parliamentary gridlock. However, since we’re far ahead of Labour in the polls, isn’t it time to arrange a vote on having a snap election?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1001, "fields": { "priority": 2, "description": "Inevitably, the biggest question of an election happening a year after a historic vote comes up. What are your plans to carry the country through the process of Brexit?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1002, "fields": { "priority": 2, "description": "4th May 2017. Unrelated to the snap election you’ve called for June, the local elections are taking place as scheduled today. A strong result for the Conservatives might strengthen our momentum heading into the general election, so what’s your plan to build this momentum?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1003, "fields": { "priority": 3, "description": "It’s possible that the Traditionalist wing of the Conservative party, including MPs like Jacob Rees-Mogg could become rather problematic if they aren’t given a party vote on the repeal of laws banning fox hunting. Will you promise a vote to repeal the Hunting Act 2004 in the Conservative manifesto?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1004, "fields": { "priority": 4, "description": "It’s time to begin writing your party’s manifesto. How do you wish to title it and what will its primary focus be on?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1005, "fields": { "priority": 5, "description": "Alright, now we’ve got the title of “Forward Together: Our Plan for a Stronger Britain and a Prosperous Future” and an outline for its contents, how will you go about presenting the information?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1006, "fields": { "priority": 5, "description": "Since becoming Prime Minister, not a lot has been noticed from you. Your strength in the polls almost entirely comes down to the extreme weakness of the opposition. As the campaign has started and Labour are already beginning to gain ground, you will have to change this and start making decisions about things, so where do you stand on one of the many crucial issues in this campaign?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1007, "fields": { "priority": 8, "description": "18th May 2017 - It’s time to unveil your manifesto, where will you go to do this?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1008, "fields": { "priority": 10, "description": "Compared to Corbyn’s rip-roaring manifesto unveiling, ours came across, let's say, a little deflated. We have concerns about your campaign ability and charisma, so we recommend you take a short amount of time off the campaign to brush up on these skills.", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1009, "fields": { "priority": 10, "description": "Environmentalist groups are concerned about your manifesto’s pledge to give Conservative MPs the vote to repeal laws on fox hunting, do you wish to elaborate on this?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1010, "fields": { "priority": 10, "description": "23rd May 2017: There was a bombing at an Ariana Grande concert in Manchester last night. 22 people were killed, and hundreds have been suspected to be injured. The Islamic terrorist group ISIS has claimed responsibility for the attack. It is the first thing you must address on this new day, what will you say?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1011, "fields": { "priority": 10, "description": "After the shocking terrorist attack, Jeremy Corbyn has pivoted to attacking the Conservatives for cuts to police funding, claiming 20,000 officers have been lost from Britain’s streets due to austerity cuts. This seems to be effective, and the conversation is shifting away from Brexit to national security. How will you respond?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1012, "fields": { "priority": 10, "description": "People are asking for more specificity about your policies in relation to Brexit. What would a Brexit deal you would be willing to negotiate for look like?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1013, "fields": { "priority": 10, "description": "The United Kingdom Independence Party (UKIP) did well in 2015, however their polling numbers have been falling throughout this campaign. Nigel Farage is still a prominent political figure in Eurosceptic politics although he no longer leads UKIP. What will you do to get 2015 UKIP voters to back the Conservatives in this election?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1014, "fields": { "priority": 10, "description": "29th May 2017: You’re going on an interview with Jeremy Paxman on Channel 4. How will you use this time?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1015, "fields": { "priority": 10, "description": "Overall, you’ve been perceived to strike a rather balanced campaign in relation to Brexit. Neither side is particularly angry at you, but nor are they particularly impressed by you. Will you continue this balanced approach or will you lean into one side of the debate?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1016, "fields": { "priority": 10, "description": "31st May 2017 - The first major debate is coming up, so perhaps it’s time to do some preparation. Will you go to the debate personally, or will you send a surrogate?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1017, "fields": { "priority": 10, "description": "It’s not just the Conservatives and Labour in this debate, the Liberal Democrats, UKIP and the Green Party are also present on the stage, all represented by their party leaders. What is the strategy that Amber Rudd should follow on the debate stage?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1018, "fields": { "priority": -6, "description": "Jeremy Corbyn is holding large outside rallies of thousands of people, whilst you’re talking in smaller indoor venues with more loyal supporters. Are you worried this will send a message that Jeremy Corbyn is more popular than you?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1019, "fields": { "priority": -5, "description": "Jeremy Corbyn accuses the Conservative party of wanting to privatise the NHS, citing growing waiting times and the Conservative government’s inaction in response to the growing strain on hospitals. What is your response?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1020, "fields": { "priority": -4, "description": "Polls from YouGov and Ipsos have been showing the decline of importance of Brexit as the dominant issue, and other issues like national security, health and social care, as well as education are starting to become as important. Based on this news, how will you adapt your campaign?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1021, "fields": { "priority": -3, "description": "A major concern in the Brexit negotiations is Northern Ireland. There are fears that ending Freedom of Movement will put a hard border on the island of Ireland, a move that would violate the Good Friday Agreement. How would you tackle this?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1022, "fields": { "priority": -3, "description": "The SNP are vulnerable in Scotland and there could be many seats up for grabs there. Will you focus your campaign strategy on Scotland, and if so, what will be your Scottish strategy?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1023, "fields": { "priority": -2, "description": "The perception is that you have taken a rather mainstream Conservative stance in relation to economic issues, Your appeal is broader, whilst fiscal conservatives are uneasy, but just about satisfied. That’s not to say this situation will stay like this. In regards to economics, how will you direct your campaign?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1024, "fields": { "priority": -1, "description": "There are suspicions that Russia interfered in the Brexit referendum, and this potentially caused “Leave” to win. Does this change your perspective on Brexit?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1025, "fields": { "priority": -1, "description": "What will you say to supporters of the Liberal Democrats to get them to back your campaign?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1026, "fields": { "priority": -1, "description": "Your campaign has a wide appeal across class divides. Balancing an appeal to working class voters without alienating the more upper class Conservative base can be difficult, but so far, you’ve managed to achieve it, even if things look a bit rocky on both sides. How will you direct your campaign in regards to socioeconomic class?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1027, "fields": { "priority": -1, "description": "Another terrorist attack has been committed during the campaign on London Bridge involving a vehicle and stabbings. 8 people have been killed, excluding three perpetrators who have been shot dead by police on the scene. ISIS have immediately claimed responsibility for the attack. How will you proceed?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1028, "fields": { "priority": -1, "description": "After another shocking terrorist attack, voters are demanding answers for how to prevent further attacks. How will you respond?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1029, "fields": { "priority": -1, "description": "2nd June 2017: It’s time for the BBC Question Time debate, which will feature just you and Jeremy Corbyn. What will be your debate focus?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1030, "fields": { "priority": -1, "description": "What will be your overall strategy in this debate?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1031, "fields": { "priority": -1, "description": "In response to the two Islamist terrorist attacks during the campaign, there has been a fivefold increased rate of Islamophobic violence. On the 23rd of May, an Islamic centre in Oldham was subject to an arson attack. Muslim activists are asking what will you do to prevent further violence? ", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1032, "fields": { "priority": -1, "description": "Compared to most issues in this campaign, social issues have taken a back seat. Will you take a stand on social issues, or prioritise another issue instead?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1033, "fields": { "priority": -1, "description": "The polls are narrowing quickly. Nobody could ever see this coming before you called the snap election. What started off as a 20 point lead has continued to tighten up towards election day. Is the Conservative campaign failing? In the closing days, what should we do to turn this around?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1034, "fields": { "priority": -1, "description": "8th June 2017: It is the final day of the campaign. Where will you go to finish your campaign?", "likelihood": 1 } }, { "model": "campaign_trail.question", "pk": 1035, "fields": { "priority": -1, "description": " You reach Wakefield, ready to give your final message. The closing words of your campaign are…", "likelihood": 1 } } ] campaignTrail_temp.answers_json = [ { "model": "campaign_trail.answer", "pk": 5000, "fields": { "question": 1000, "description": "It is time to hold an election, I agree with you. Today I will hold a vote under the Fixed Term Parliaments Act 2011 to declare a snap election. I will begin this campaign with a general unifying tone to unite all those who are opposed to the far-left radicalism of Labour." } }, { "model": "campaign_trail.answer", "pk": 5001, "fields": { "question": 1000, "description": "I agree, it’s time for an election. Today I will hold a vote under the Fixed Term Parliaments Act 2011 to declare a snap election. I will begin this campaign with a focus on my intentions in regards to Brexit, and ask the British people for a healthy majority to raise our profile in the negotiations with Brussels." } }, { "model": "campaign_trail.answer", "pk": 5002, "fields": { "question": 1000, "description": "Alright, I can see it’s a good time to do so. Today I will hold a vote under the Fixed Term Parliaments Act 2011 to declare a snap election. I will begin this campaign by leveraging the Conservatives’ newfound support among working class people post-Brexit vote. Let’s go after Labour’s “red wall”." } }, { "model": "campaign_trail.answer", "pk": 5003, "fields": { "question": 1000, "description": "We couldn’t have been gifted a better opportunity than this. Today I will hold a vote under the Fixed Term Parliaments Act 2011 to declare a snap election. I will begin this campaign by leaning into the successes of our Scottish Conservatives leader, Ruth Davidson, and aim to win as many seats as possible in Scotland." } }, { "model": "campaign_trail.answer", "pk": 5004, "fields": { "question": 1001, "description": "Brexit means Brexit, we must respect the results of this referendum. In March I invoked Article 50 to officially begin the process of withdrawal from the EU. If you give us a stronger majority in June, we will be able to make our position in the negotiations stronger, and ensure the best for Britain." } }, { "model": "campaign_trail.answer", "pk": 5005, "fields": { "question": 1001, "description": "In tumultuous times like these, we need strong and stable leadership in the national interest. The Conservatives will offer this strong and stable leadership, whilst Labour will offer chaos and instability. The sensible decision in June is to vote for the Conservatives." } }, { "model": "campaign_trail.answer", "pk": 5006, "fields": { "question": 1001, "description": "This is a unique election for a Conservative, so I will consider moderating my Conservative economic and social views in order to make the party as appealing as possible to working class and moderate Labour voters who are concerned about Labour’s shift away from the mainstream." } }, { "model": "campaign_trail.answer", "pk": 5007, "fields": { "question": 1001, "description": "We can’t have our campaign become a single issue campaign, people will get tired of hearing “Brexit, Brexit, Brexit”, so we will also place issues like national security, health and social care, as well as education in the forefront of our campaign." } }, { "model": "campaign_trail.answer", "pk": 5008, "fields": { "question": 1002, "description": "Our best approach is to contrast ourselves with Labour. The Conservatives are reasonable and pragmatic. We are closer to the views of the average British voter. Labour have taken a turn to the far-left and they are as out of touch now as they were in the 1980s." } }, { "model": "campaign_trail.answer", "pk": 5009, "fields": { "question": 1002, "description": "Let’s give a final boost to our mayoral candidates in Tees Valley and the West Midlands. If the Conservatives win these, it will really go to show our unprecedented strength in working class areas. Let’s divert some of our funding to Ben Houchen and Andy Street to give them a last minute boost." } }, { "model": "campaign_trail.answer", "pk": 5010, "fields": { "question": 1002, "description": "Our local efforts are best if I’m not explicitly connected to them. I will leave the Conservative Party to wrap up the local campaigns in the best way they know how. We must keep in mind the difference between a local and national election." } }, { "model": "campaign_trail.answer", "pk": 5011, "fields": { "question": 1002, "description": "We will head back up to Scotland again. Ruth Davidson is a very talented leader who will be able to maximise our gains in the local elections across Scotland." } }, { "model": "campaign_trail.answer", "pk": 5012, "fields": { "question": 1003, "description": "I cannot have a large faction of my party walking out on me at this time, so I will give them the vote, but I’ll stay quiet about it if the party votes in support of it." } }, { "model": "campaign_trail.answer", "pk": 5013, "fields": { "question": 1003, "description": "Fox hunting is an extremely important British tradition and I will stand by our rural communities, letting people hunt freely as they have done for so long. I will enthusiastically endorse the repeal of the Hunting Act 2004 as part of my campaign." } }, { "model": "campaign_trail.answer", "pk": 5014, "fields": { "question": 1003, "description": "I will allow the vote, both for the sake of party unity and also as a sign of respect for British traditions. Conservative MPs will have their chance to make their voices heard, and I will respect their decision." } }, { "model": "campaign_trail.answer", "pk": 5015, "fields": { "question": 1003, "description": "Absolutely not. I will not be giving them the vote to repeal the laws against fox hunting. I can’t have the campaign be tarnished by something so unpopular and controversial." } }, { "model": "campaign_trail.answer", "pk": 5016, "fields": { "question": 1004, "description": "“Forward Together: Our Plan for a Stronger Britain and a Prosperous Future” - We will prioritise our economic goals. The Conservatives promise growth whilst Labour’s far-left radicalism will hold us back." } }, { "model": "campaign_trail.answer", "pk": 5017, "fields": { "question": 1004, "description": "“Strong and Stable Leadership: A Plan for a Secure Future for Britain” - We need to lean into the issues underpinning the vote to leave. People want security and stability, and have felt they’ve lacked those as a member of the EU." } }, { "model": "campaign_trail.answer", "pk": 5018, "fields": { "question": 1004, "description": "“Sovereignty, Borders, Freedom: Breaking the shackles of Brussels” - Brexit is our winning issue, and we’ll lean hard into that. Our manifesto is a Brexit manifesto, all about the things that we voted for then, that I’ll carry out with a larger majority." } }, { "model": "campaign_trail.answer", "pk": 5019, "fields": { "question": 1004, "description": "“A New Age of Prosperity: How Britain Will Thrive” - I wish to strike an optimistic tone. We are entering a new future, and I want to get across the positives that will be achieved by the Conservatives in our next government with a stronger majority." } }, { "model": "campaign_trail.answer", "pk": 5020, "fields": { "question": 1005, "description": "We need to keep a balanced approach. The manifesto must be accessible to less educated voters, but we can’t be too eager to, for a lack of a better term, dumb down our material to the point we alienate our educated voters." } }, { "model": "campaign_trail.answer", "pk": 5021, "fields": { "question": 1005, "description": "This campaign is about reaching out. If we are to break down Labour’s “red wall” in the north, we need to ensure that our material is accessible to them. Brevity is the soul of wit, so let’s keep it short and straightforward." } }, { "model": "campaign_trail.answer", "pk": 5022, "fields": { "question": 1005, "description": "We have a lot to mention, our proposed policies on many different components of Brexit, and of domestic policies, and I would like the manifesto to explain these thoroughly. I want our policies to be understood, even if the manifesto ends up being a little longer than originally intended." } }, { "model": "campaign_trail.answer", "pk": 5023, "fields": { "question": 1005, "description": "I will leave this to the party staffers, as I trust them to make the best decisions in regards to how we deliver the information in our manifesto." } }, { "model": "campaign_trail.answer", "pk": 5024, "fields": { "question": 1006, "description": "Our appeal is a broad appeal. As Labour is so out of touch with everyday people, we are placed in a position where making concrete policy proposals will merely alienate one swath of voters. This is a strength, not a weakness." } }, { "model": "campaign_trail.answer", "pk": 5025, "fields": { "question": 1006, "description": "I might have been wrong about my views on Labour. Yes, they’re out of the mainstream, but now the campaign has begun, we’re already seeing Labour’s numbers growing. We have to bring a much stronger attacking campaign against them to blunt this momentum." } }, { "model": "campaign_trail.answer", "pk": 5026, "fields": { "question": 1006, "description": "I might have been wrong about Labour. They may be out of the mainstream, but they’re quickly gathering momentum. Therefore we must take some stronger policy stances. As Brexit is our strongest issue, let’s direct our campaign more towards that." } }, { "model": "campaign_trail.answer", "pk": 5027, "fields": { "question": 1006, "description": "I might have been wrong about Labour. They may be out of the mainstream, but they’re quickly gathering momentum on domestic issues. We need to ensure we can counter their arguments. Traditionally, national security is an important Conservative-leaning issue, so let’s prioritise that more." } }, { "model": "campaign_trail.answer", "pk": 5028, "fields": { "question": 1049, "description": "Let’s unveil it in the heart of our country, our capital city of London, home to 8 million people from many different backgrounds and beliefs, from our Bangladeshi communities in Tower Hamlets, to our Afro-Caribbean communities in places like Brixton, our message is we care about everyone. " } }, { "model": "campaign_trail.answer", "pk": 5029, "fields": { "question": 1043, "description": "Let’s unveil it in the education hub of our country, Oxford University. This is one of the most prestigious universities in not just the country, but the entire world. This is a campaign I want young and educated people to look positively at." } }, { "model": "campaign_trail.answer", "pk": 5030, "fields": { "question": 1046, "description": "Let’s unveil it up North in Yorkshire, where we will be able to make a stronger connection with the working class vote. This election isn’t like other elections, this time we have an actual chance to win these areas." } }, { "model": "campaign_trail.answer", "pk": 5031, "fields": { "question": 1050, "description": "Let’s unveil it up in Scotland, alongside Ruth Davidson, the popular leader of the Scottish Conservatives. Our strategy of asserting ourselves as the primary unionist opposition to the SNP could bear a lot of fruit." } }, { "model": "campaign_trail.answer", "pk": 5032, "fields": { "question": 1008, "description": "Unfortunately, we haven’t got time for these diversions. I am concerned about Corbyn’s rise in the polls, and need to keep myself on the front lines holding campaign events where I attend. I am the Prime Minister after all." } }, { "model": "campaign_trail.answer", "pk": 5033, "fields": { "question": 1008, "description": "You know, maybe you’re right. I want it to be quick, I can’t take more than a couple of days off, but some time to brush up on my public speaking skills will probably be a net positive." } }, { "model": "campaign_trail.answer", "pk": 5034, "fields": { "question": 1008, "description": "Sensible ideas tend to struggle when your opponent is presenting a completely infeasible vision of the future. I can’t waste time and be out of the campaign, but stressing that the Conservatives are the common sense choice will help overcome these downsides of my campaign." } }, { "model": "campaign_trail.answer", "pk": 5035, "fields": { "question": 1008, "description": "Alright, alright, I understand, I’m not the best public speaker and need to improve. I’m open to taking all the time I need in order to maximise my chances of winning the election in June. If that means taking some time off to work on my public speaking skills, then so be it." } }, { "model": "campaign_trail.answer", "pk": 5036, "fields": { "question": 1009, "description": "We need a united party, I can’t have the traditionalist wing of the Conservative party rebel at this crucial time. This is why I called this snap election to begin with, we ask the British people for a majority to raise our standings in the negotiations with the EU." } }, { "model": "campaign_trail.answer", "pk": 5037, "fields": { "question": 1009, "description": "Fox hunting is part of our proud British heritage. As Conservatives, it is our duty to stand up and defend British traditions. I’m sure many Conservatives appreciate this." } }, { "model": "campaign_trail.answer", "pk": 5038, "fields": { "question": 1009, "description": "I understand the outrage and their concerns that fox hunting is cruel, but this is a conservation practice. We need to monitor the fox population closely in order to both protect our farmers and other wildlife." } }, { "model": "campaign_trail.answer", "pk": 5039, "fields": { "question": 1009, "description": "There are more important issues to focus on than this. When it comes up, I’ll redirect the conversation to those issues." } }, { "model": "campaign_trail.answer", "pk": 5040, "fields": { "question": 1010, "description": "This is a horrible and tragic event. I will declare a period of mourning in respect of the victims and pause our campaign. Today I will give a uniting and calming speech. It wouldn’t be right to politicise a tragedy like this." } }, { "model": "campaign_trail.answer", "pk": 5041, "fields": { "question": 1010, "description": "This is a horrible and tragic event. I will declare a period of mourning in which our campaign activity will be paused. I will head up to Manchester and personally meet up with the victims who need to know a Conservative government will have their backs." } }, { "model": "campaign_trail.answer", "pk": 5042, "fields": { "question": 1010, "description": "This was a disgraceful act. I will declare a period of mourning in which our campaign activity will be paused. My first speech today will be about the needs for stronger immigration checks and more vigilance in intercepting these attacks in the planning phase. We need to give the police more powers to monitor potential extremists to prevent future attacks." } }, { "model": "campaign_trail.answer", "pk": 5043, "fields": { "question": 1010, "description": "This was a horrifying attack, I will declare a period of mourning in respect and pause our campaign. This was a disgusting, sick perversion of Islam. It is not what the religion represents to most of its adherents. We must also concern ourselves with a backlash of anti-Islamic hate too. Our diversity is our strength." } }, { "model": "campaign_trail.answer", "pk": 5044, "fields": { "question": 1011, "description": "This is one place we have to distance ourselves from previous Conservative governments. Behind closed doors I can’t deny that austerity under David Cameron’s government has led to cuts in police funding which has indeed left our streets more dangerous. I will call for a reversal of these cuts and put 20,000 more bobbies on the beat." } }, { "model": "campaign_trail.answer", "pk": 5045, "fields": { "question": 1011, "description": "With the shocking attack that occurred, we must acknowledge the importance of national security to the voting public. The vote to leave the EU will help us achieve these goals of becoming a safer, more secure nation, so we must not forget the importance of Brexit negotiations in this conversation." } }, { "model": "campaign_trail.answer", "pk": 5046, "fields": { "question": 1011, "description": "Jeremy Corbyn does not support making this country more secure, quite the opposite. He supports taking Britain out of NATO, which will leave us more vulnerable on the world stage to hostile powers like Russia and China. We cannot let him become Prime Minister." } }, { "model": "campaign_trail.answer", "pk": 5047, "fields": { "question": 1011, "description": "Leaving the EU will put us on the path to being more secure, able to control our own borders, and make our own laws, and who would you prefer be in control of that process? Do you trust a left wing radical with our nation’s security?" } }, { "model": "campaign_trail.answer", "pk": 5048, "fields": { "question": 1012, "description": "We must end freedom of movement. We must take back control of our borders to give us the ability to control who is allowed into our country and who isn’t. This will make our country more secure, especially with the wave of terrorist violence we’ve seen escalate over the decade." } }, { "model": "campaign_trail.answer", "pk": 5049, "fields": { "question": 1012, "description": "We need to negotiate a deal that will give us the smoothest transition from EU member to being independent. We can’t end up shocking our businesses with unexpected changes. The Conservatives will ensure a smooth transition, whilst Labour will neglect our British businesses." } }, { "model": "campaign_trail.answer", "pk": 5050, "fields": { "question": 1012, "description": "Let me stress this first of all: No deal is better than a bad deal. It isn’t going to be easy to negotiate everything we want, but my Conservative government will stand firmly behind our red lines on border security and national sovereignty. If we can’t get a deal that respects these, I’m willing to leave without a deal." } }, { "model": "campaign_trail.answer", "pk": 5051, "fields": { "question": 1012, "description": "I will ensure we get a deal. The risks of crashing out without a deal are too high. At the same time, we must acknowledge why people voted to leave. They want control of their country back, controls on immigration and border security. I will ensure the deal we end up with respects these concerns." } }, { "model": "campaign_trail.answer", "pk": 5052, "fields": { "question": 1013, "description": "I will promise that we will be out of the EU during my next term. That I will guarantee you. Brexit means Brexit." } }, { "model": "campaign_trail.answer", "pk": 5053, "fields": { "question": 1013, "description": "UKIP concerns themselves heavily with immigration. I will focus on attracting UKIP voters through promising a stronger points-based immigration system, keeping out low-skilled labourers who will take jobs away from British workers." } }, { "model": "campaign_trail.answer", "pk": 5054, "fields": { "question": 1013, "description": "Brexit means Brexit, and if we can’t get a deal that respects our strong red lines in regards to immigration, then we’re willing to leave without a deal altogether. No deal is better than a bad deal." } }, { "model": "campaign_trail.answer", "pk": 5055, "fields": { "question": 1013, "description": "Appealing to 2015 UKIP voters is too risky. We need to primarily focus on Labour voters if we’re going to increase our majority like I set out to. Also we can’t alienate our “blue wall”. We can’t have an exodus of voters in the South." } }, { "model": "campaign_trail.answer", "pk": 5056, "fields": { "question": 1014, "description": "We will talk about our plans for negotiating a Brexit deal, how we will guide the country through the tough road ahead of us, and we ask the British people for a majority in Parliament so we can ensure the best deal possible." } }, { "model": "campaign_trail.answer", "pk": 5057, "fields": { "question": 1014, "description": "I am concerned I’m not as personable as I’d like, so I’ll spend some of this time talking about my personal life, my childhood upbringing, and try to be more relatable. The voters often don’t see these sides in the heat of a campaign." } }, { "model": "campaign_trail.answer", "pk": 5058, "fields": { "question": 1014, "description": "We will use this time not just to talk about Brexit, but to also talk about our domestic policy proposals, how we will make the country safer, our plans for health and social care, education, environmental issues, and so-on." } }, { "model": "campaign_trail.answer", "pk": 5059, "fields": { "question": 1014, "description": "We will use this time to attack Labour and Jeremy Corbyn. We must get across the danger that he poses to our United Kingdom. He supports withdrawing from NATO and has campaigned with a movement that wishes to dismantle our Trident nuclear deterrent. Jeremy Corbyn is too dangerous for Britain." } }, { "model": "campaign_trail.answer", "pk": 5060, "fields": { "question": 1015, "description": "We will continue this balanced approach. We have to hold this coalition together the best we can to maximise our majority in this election." } }, { "model": "campaign_trail.answer", "pk": 5061, "fields": { "question": 1015, "description": "We will lean into the more hard Brexit side of the discussion a little, by promising that we’ll only accept a Brexit deal that gives us significant control over our borders and exercise our national sovereignty." } }, { "model": "campaign_trail.answer", "pk": 5062, "fields": { "question": 1015, "description": "The polls in Remain supporting areas worry me, and as such we need to throw some bones to the Remain voters. Of course we can’t go against Article 50, but we will promise that we won’t crash out without a deal, and we will look to form an agreement similar to Norway’s." } }, { "model": "campaign_trail.answer", "pk": 5063, "fields": { "question": 1015, "description": "Whilst we have held up this coalition so far, we know for sure it isn’t sustainable and the middle ground itself is unpopular. Therefore we have to create a synthesis of positions. We will prioritise border security, whilst looking at what we can do to keep relations with Europe healthy." } }, { "model": "campaign_trail.answer", "pk": 5064, "fields": { "question": 1016, "description": "I will send Amber Rudd, my Home Secretary as a surrogate to this debate. She will prioritise the issues of national security in this debate, which I understand that many of you care about at this time." } }, { "model": "campaign_trail.answer", "pk": 5065, "fields": { "question": 1016, "description": "I will send David Davis, my Brexit Secretary as a surrogate to this debate. He will prioritise communicating our plans for how we will leave the EU in this debate, which is an important issue that affects all other issues." } }, { "model": "campaign_trail.answer", "pk": 5066, "fields": { "question": 1016, "description": "I will send Philip Hammond, my Chancellor of the Exchequer to this debate. He will prioritise our economic plans in the future related to Brexit, as well as discussing what we will do for our domestic policies regarding many important issues." } }, { "model": "campaign_trail.answer", "pk": 5067, "fields": { "question": 1016, "description": "I will attend the debate in person. It is important that a Prime Minister represents their party on the debate stage in crucial election campaigns like this one." } }, { "model": "campaign_trail.answer", "pk": 5068, "fields": { "question": 1017, "description": "Amber Rudd should throw some attacks towards the Liberal Democrats. If they had it their way, they’d scrap Article 50 and betray the 2016 decision the British people made to leave the European Union." } }, { "model": "campaign_trail.answer", "pk": 5069, "fields": { "question": 1017, "description": "Amber Rudd should direct attacks against UKIP. We are getting out of the EU in my next term I can assure that, but we can’t have a mainstream party who campaigns on hate and xenophobia. Paul Nuttall called for a war against “cultural Marxists”, This hateful, antisemitic language is unacceptable." } }, { "model": "campaign_trail.answer", "pk": 5070, "fields": { "question": 1017, "description": "As the governing party we must be prepared to be attacked from every direction. Amber Rudd will be pressed into the defending position, and we must ensure she’s able to respond effectively to every argument that gets thrown at her." } }, { "model": "campaign_trail.answer", "pk": 5071, "fields": { "question": 1017, "description": "Amber Rudd should keep this a two horse race. Our target is the Labour party." } }, { "model": "campaign_trail.answer", "pk": 5072, "fields": { "question": 1087, "description": " I’m not worried, no. We’re ahead in the polls, and if we keep up our current strategy we can win the majority we need for raising our profile in the Brexit negotiations." } }, { "model": "campaign_trail.answer", "pk": 5073, "fields": { "question": 1018, "description": "I am a little worried, I won’t lie. We will mostly stick to our smaller, more intimate rallies, but where the situation calls for it we can have some larger rallies where we can prioritise issues that have a more populist flair to them." } }, { "model": "campaign_trail.answer", "pk": 5074, "fields": { "question": 1018, "description": "This is a problem, we need to hold larger rallies if we’re going to compete effectively with Corbyn. We will arrange more events in concert halls where we can have hundreds of attendees." } }, { "model": "campaign_trail.answer", "pk": 5075, "fields": { "question": 1087, "description": "This is where our campaigns fundamentally differ. When you’re promising blind naive idealism, you can get a crowd roaring. When you’re promising the real world, people just don’t cheer as much for that. Our attempts to hold big crowds will fail, so let’s spare ourselves that embarrassment." } }, { "model": "campaign_trail.answer", "pk": 5076, "fields": { "question": 1019, "description": "I find the idea that we want to privatise our award winning healthcare system preposterous. We will under no circumstances privatise our national health service. Any accusations that we wish to are categorically false." } }, { "model": "campaign_trail.answer", "pk": 5077, "fields": { "question": 1019, "description": "We don’t wish to privatise the NHS, full stop. Meanwhile has Jeremy Corbyn answered about his proposals to dismantle our nuclear deterrent?" } }, { "model": "campaign_trail.answer", "pk": 5078, "fields": { "question": 1019, "description": "We will not privatise the NHS under any circumstances, but we must respond to present circumstances. Where it will be more effective to provide care, we will allow private providers to offer NHS services, but do be assured, the NHS will not be privatised." } }, { "model": "campaign_trail.answer", "pk": 5079, "fields": { "question": 1019, "description": "Our NHS is being strained right now and we have a shortage of nurses. We have to be realistic about the healthcare quality and quantity the NHS is going to be able to supply. Overall it might be better if similar to dentistry, some other parts of our healthcare system are handled privately." } }, { "model": "campaign_trail.answer", "pk": 5080, "fields": { "question": 1020, "description": "We can’t surrender the entire discussion on health and social care to Jeremy Corbyn’s coalition of chaos. We’ve stood by the NHS since its founding after World War 2, and we will ensure that it gets the funding it needs to provide care to all who need it." } }, { "model": "campaign_trail.answer", "pk": 5081, "fields": { "question": 1020, "description": "That’s fine, national security is still a winning issue for us. Remember, our opposition is led by a man who wants to disarm our nuclear deterrent and pull us out of NATO, leaving us prey to the whims of Russia and China. You can only be safe with the Conservatives." } }, { "model": "campaign_trail.answer", "pk": 5082, "fields": { "question": 1020, "description": "We have plans to vastly improve education in our next term. The Conservative party advocates for more choice for parents deciding where to send their children, we will allow grammar schools, and we need our schooling to be more focused on real world problems. Too many people exit schooling with no idea how to get a job, start a business, or manage their finances. That has to change." } }, { "model": "campaign_trail.answer", "pk": 5083, "fields": { "question": 1020, "description": "We cannot let go of the Brexit issue, as all of these other issues are underpinned by it. We have to do all we can to refocus Brexit as the primary issue in this campaign." } }, { "model": "campaign_trail.answer", "pk": 5084, "fields": { "question": 1021, "description": "We must protect the integrity of the Good Friday agreement whatever we do. This means no hard border on the island of Ireland, and we will have to figure out another way to work around this problem. For now, we will preserve the Common Travel Area with the Republic of Ireland." } }, { "model": "campaign_trail.answer", "pk": 5085, "fields": { "question": 1021, "description": "Unfortunately, our future outside of the EU complicates matters. I cannot rule out a hard border as of this moment, although it isn’t the ideal scenario. A Swiss style border system, where random checks will take place of people and goods moving across the border may be an appropriate compromise." } }, { "model": "campaign_trail.answer", "pk": 5086, "fields": { "question": 1021, "description": "We cannot violate the Good Friday Agreement by putting a hard border on the island of Ireland, but we also can’t leave a hole in our customs border that could allow dangerous goods into our country. It isn’t ideal, but a temporary policy of customs checks between Great Britain and Ireland might be required." } }, { "model": "campaign_trail.answer", "pk": 5087, "fields": { "question": 1021, "description": "In order to maintain our adherence to the Good Friday Agreement, we must accept that we will have to stay in the Customs Union and allow freedom of movement between the United Kingdom and the Republic of Ireland." } }, { "model": "campaign_trail.answer", "pk": 5088, "fields": { "question": 1022, "description": "Absolutely we will. Scotland is a major priority and I will arrange a visit in person to meet our Scottish Conservatives leader Ruth Davidson. I am very proud of what she has achieved for the Conservatives in Scotland, and I will stand with her in our Scottish campaign." } }, { "model": "campaign_trail.answer", "pk": 5089, "fields": { "question": 1022, "description": "The majority of voters in Scotland voted to remain in 2016. As Prime Minister, I represent all four constituent countries of the United Kingdom, and to represent Scotland, I will honour their wishes to remain within the Customs Union and keep our trade with Europe as frictionless as possible." } }, { "model": "campaign_trail.answer", "pk": 5090, "fields": { "question": 1022, "description": "The Conservative Party’s full name is the Conservative and Unionist Party, and this second part “Unionist” refers very well to our strategy in Scotland. Scotland voted “no” in the 2014 Scottish independence referendum, and we stand by their decision. No destructive second referendum!" } }, { "model": "campaign_trail.answer", "pk": 5091, "fields": { "question": 1022, "description": "Scotland is not a major target for us in this campaign. Our main target is Labour’s “red wall”. Visiting Scotland might muddle our message with Brexit that we’re trying to get across. I will leave the Scottish campaign to Ruth Davidson as she has shown great talent in warming Scotland to the Conservatives." } }, { "model": "campaign_trail.answer", "pk": 5092, "fields": { "question": 1023, "description": "We will stay the course on our economic approach. We’re in a place where the Conservatives are accessible for moderates to vote for, whilst our right wing flank hasn’t deserted us. Let’s try to maintain this state of affairs." } }, { "model": "campaign_trail.answer", "pk": 5093, "fields": { "question": 1023, "description": "We have to keep the right flank behind us. Let’s emphasise proposals to cut taxes and reduce spending. These always play well with voters." } }, { "model": "campaign_trail.answer", "pk": 5094, "fields": { "question": 1023, "description": "We could definitely do more to extend an olive branch to economically left-leaning voters. Let’s covertly poach some policies from earlier Labour manifestos that will appeal to the more sensible of Labour’s supporters, who aren’t behind the insanity of Corbyn. We will promise some targeted increases of funding for public services." } }, { "model": "campaign_trail.answer", "pk": 5095, "fields": { "question": 1023, "description": "Economic issues aren’t that major a focus in this election, let’s spend this time focusing on Brexit and national security instead." } }, { "model": "campaign_trail.answer", "pk": 5096, "fields": { "question": 1024, "description": "What’s done is done, the country voted to leave and we must respect that decision." } }, { "model": "campaign_trail.answer", "pk": 5097, "fields": { "question": 1024, "description": "We do have questions and will issue a more thorough investigation of the referendum in my next term. If we find significant Russian influence, we may consider holding a secure second referendum. We can’t be at the whims of a foreign power like Russia." } }, { "model": "campaign_trail.answer", "pk": 5098, "fields": { "question": 1024, "description": "We have questions that scrutinise the ethics of the Leave side and their campaign. Follow-up investigations have uncovered some unlawful campaign activities. However, we must ensure the integrity of our referendums. We will honour the 2016 vote, whilst minimising the amount of ties we cut with Europe." } }, { "model": "campaign_trail.answer", "pk": 5099, "fields": { "question": 1024, "description": "These are just suspicions, we haven’t had any concrete evidence to point to a high likelihood that Russia influenced the path that Britain has taken. We’ll investigate the security of the referendum after the election, but I will rule out an unpopular second referendum." } }, { "model": "campaign_trail.answer", "pk": 5100, "fields": { "question": 1025, "description": "I won’t. The Liberal Democrats are consolidating the Remain-supporting vote. It will be difficult for us to appeal to them without alienating Leave supporters, so it’s best to ignore them." } }, { "model": "campaign_trail.answer", "pk": 5101, "fields": { "question": 1025, "description": "The Liberal Democrats are a party of few fixed principles. They are opportunists who will leap from one trend to the next, without any underlying guiding philosophy. Meanwhile the Conservatives have principles and underlying guidance in what we stand for." } }, { "model": "campaign_trail.answer", "pk": 5102, "fields": { "question": 1025, "description": "I will promise that I will get a Brexit deal for the country that does not break us off from Europe. If you support remaining in the European Economic Area and the Customs Union, don’t worry, a Conservative Government will respect that position. We will have a relationship with the EU similar to Norway." } }, { "model": "campaign_trail.answer", "pk": 5103, "fields": { "question": 1025, "description": "I will, but I’ll stress that we are sticking to our Brexit strategy. In return I will make some concessions on social issues within their manifesto, like being more lenient on cannabis use, and we’ll offer to Parliament a vote to increase paternal leave." } }, { "model": "campaign_trail.answer", "pk": 5104, "fields": { "question": 1026, "description": "I like to think Benjamin Disraeli would be proud of me. Our campaign is succeeding at presenting a compassionate brand of Conservative politics, so let’s keep this up." } }, { "model": "campaign_trail.answer", "pk": 5105, "fields": { "question": 1026, "description": "I don’t think this is a coalition we can hold together forever, so let’s lean into the larger number of voters. We’ll ramp up our populist appeal in the closing weeks of this campaign." } }, { "model": "campaign_trail.answer", "pk": 5106, "fields": { "question": 1026, "description": "We must be very careful not to alienate our upper class base, so we can’t drop our sophisticated edge to chase the votes of the masses. An exodus of votes to the Liberal Democrats is the last thing we need." } }, { "model": "campaign_trail.answer", "pk": 5107, "fields": { "question": 1026, "description": "We can’t get tied up on class divides, we need to keep the issues at the forefront. Let’s continue talking about our plans for withdrawal from the EU and what we’ll do to make the country safer." } }, { "model": "campaign_trail.answer", "pk": 5108, "fields": { "question": 1091, "description": "I am deeply saddened by this event. I will return to London and declare another period of mourning. We will pause our campaign and I will give a speech urging calm and unity. We must remain tactful about this shocking tragedy." } }, { "model": "campaign_trail.answer", "pk": 5109, "fields": { "question": 1027, "description": "I will return to London with sorrow in my heart, pause our campaign and speak about our resolve. We will stay united against the forces that wish to divide us. The forces of hate will not undermine or resolve. We will remain strong, formidable, we are a nation that will not fall to the forces of hate and division." } }, { "model": "campaign_trail.answer", "pk": 5110, "fields": { "question": 1091, "description": " I’m shocked. I will return to London, pause our campaign, and deliver a speech congratulating the service of our police in preventing this attack from being worse, and I will stick by my stance that these attacks are being bred by online recruitment. We need additional tools to monitor hateful organisations to prevent future attacks like this." } }, { "model": "campaign_trail.answer", "pk": 5111, "fields": { "question": 1091, "description": " I will with sorrow, return to London, pause our campaign, meet with local Islamic leaders and give a speech about how these attacks are a perversion of the Islamic faith. Our British Muslim communities stand in solidarity against hateful violence like this." } }, { "model": "campaign_trail.answer", "pk": 5112, "fields": { "question": 1028, "description": "I stand by my position in the manifesto. These attacks are being bred by the internet, and to prevent them we need to increase our powers to monitor online communications in order to intercept these attacks as they’re being planned." } }, { "model": "campaign_trail.answer", "pk": 5113, "fields": { "question": 1028, "description": "Behind closed doors I’m not too happy with previous Conservative governance under David Cameron with austerity slashing police funding. We will heavily invest funding into our police forces to increase the numbers of officers on duty. We aim to increase police numbers by at least 20,000 in my next term." } }, { "model": "campaign_trail.answer", "pk": 5114, "fields": { "question": 1028, "description": "Our future after leaving the European Union will help with our national security, giving us control over our borders to ensure that terrorists don’t end up coming into our country. Two of the three attackers on London Bridge were illegal immigrants. We need to take control of our border!" } }, { "model": "campaign_trail.answer", "pk": 5115, "fields": { "question": 1028, "description": "We must be weary about surrendering our rights for the allure of security. However, that doesn’t mean we can’t do anything. We need to ramp up the Prevent programme, which will help us facilitate the de-radicalisation of people who end up drawn to extremism." } }, { "model": "campaign_trail.answer", "pk": 5116, "fields": { "question": 1029, "description": "With the two terrorist attacks that have occurred during this campaign, we have to prioritise the issue of national security in the debates. We have answers on these issues that Labour do not." } }, { "model": "campaign_trail.answer", "pk": 5117, "fields": { "question": 1029, "description": "We need to bring the discussion back to Brexit, and connect Brexit to the other issues that have taken precedence in this campaign. Concerns about immigration are significant right now, and we need to keep the focus on that." } }, { "model": "campaign_trail.answer", "pk": 5118, "fields": { "question": 1029, "description": "We’ll hit Corbyn where it hurts. He has still not answered concretely if he would dismantle our Trident nuclear deterrent and maintain our membership of NATO. We must ask if we’re safe under Labour." } }, { "model": "campaign_trail.answer", "pk": 5119, "fields": { "question": 1029, "description": "We’ll prepare across a wide array of issues that could come up. We have prepared arguments for Brexit, national security, nuclear weapons policy, health and social care, education, and others. We will be ready for everything Corbyn has to throw at us." } }, { "model": "campaign_trail.answer", "pk": 5120, "fields": { "question": 1030, "description": "Remain calm and composed. Stay in control, present strength and stability. We will dismantle Jeremy Corbyn in a refined, controlled manner." } }, { "model": "campaign_trail.answer", "pk": 5121, "fields": { "question": 1030, "description": "Go on the attack. Corbyn has many vulnerabilities that we can take advantage of. Let’s hammer hard on those." } }, { "model": "campaign_trail.answer", "pk": 5122, "fields": { "question": 1030, "description": "We need to make sure I can be more relatable. I will try to avoid using language that can be too academic, in order to be more relatable to working class voters." } }, { "model": "campaign_trail.answer", "pk": 5123, "fields": { "question": 1030, "description": "You know what, I will listen to my strategists and advisers for how I should debate Corbyn. The stakes are too high for me to potentially make a catastrophic mistake." } }, { "model": "campaign_trail.answer", "pk": 5124, "fields": { "question": 1031, "description": "We must prosecute Islamophobic hate crimes more severely with harsher sentences. We must get across the message that these instances of violence are unacceptable. The Crown Court needs to accurately classify these violent incidents as hate crimes." } }, { "model": "campaign_trail.answer", "pk": 5125, "fields": { "question": 1031, "description": "The hate being spouted by UKIP is heavily responsible for this rise in hate. They have aligned themselves with far-right and Islamophobic movements like the EDL who are stoking the hatred. We denounce all forms of political violence in all their forms. Can Paul Nuttall say the same?" } }, { "model": "campaign_trail.answer", "pk": 5126, "fields": { "question": 1031, "description": "I have touched on this in my manifesto and I stick by it. These attacks are being bred by the internet. We need to intercept hate groups and punish their members accordingly. We will not stand for hate under any circumstances." } }, { "model": "campaign_trail.answer", "pk": 5127, "fields": { "question": 1031, "description": "It’s unfortunate, but we must acknowledge there are consequences to Islamist terrorism. We need to strengthen our immigration system. When nothing is done in the face of such violence, people end up resorting to vigilantism. We must stop the source of the anger, and these attacks will stop." } }, { "model": "campaign_trail.answer", "pk": 5128, "fields": { "question": 1032, "description": "There is no need to complicate things. Our strongest issue is Brexit, and in the closing week of the campaign, let’s circle back to the importance of this election in determining the future of Britain, as we head into the negotiations rooms with Brussels." } }, { "model": "campaign_trail.answer", "pk": 5129, "fields": { "question": 1032, "description": "There is no need to complicate things. As we’ve moved later into this campaign, issues surrounding national security have taken the front and centre position in Britain’s wider conversation. Let’s keep discussing what we will do to make Britain safer." } }, { "model": "campaign_trail.answer", "pk": 5130, "fields": { "question": 1032, "description": "I have noticed some rather unenthusiastic performances from some MPs from our Traditionalist wing, and in response I will return to my pledge to lift the ban on selective grammar schools, something many of them will be excited to hear about. Let’s see if that lifts their spirits." } }, { "model": "campaign_trail.answer", "pk": 5131, "fields": { "question": 1032, "description": "I am proud of the advancements our country has made in regards to LGBT rights. We legalised same-sex marriage in 2014, and I am proud to continue our progress on civil rights." } }, { "model": "campaign_trail.answer", "pk": 5132, "fields": { "question": 1033, "description": "We need to dig further into Jeremy Corbyn’s past to see what we can find. If we look long enough, I’m sure we can find something severe enough that can derail his entire campaign." } }, { "model": "campaign_trail.answer", "pk": 5133, "fields": { "question": 1033, "description": "Let’s intensify our campaigning in the closing days. I will hold larger rallies and try to tap into the enthusiasm that has persisted through this campaign." } }, { "model": "campaign_trail.answer", "pk": 5134, "fields": { "question": 1033, "description": "I will give a speech about the importance and gravity of this election in a matter-of-fact, down-to-earth manner. People need to know what is at stake in this election, how it will affect the future in relation to the Brexit negotiations, and our nation’s security. I encourage all news stations to broadcast this deliberately nonpartisan speech." } }, { "model": "campaign_trail.answer", "pk": 5135, "fields": { "question": 1033, "description": "We might need to spend some time shoring up party unity in the Conservative party, lest a faction of the party’s turnout ends up being depressed. We need all hands on deck to win this election with a functional majority." } }, { "model": "campaign_trail.answer", "pk": 5136, "fields": { "question": 1034, "description": "We will head up to Yorkshire. Seats like Wakefield fit the profile of the kind of red wall seats that could potentially be won by us in this election." } }, { "model": "campaign_trail.answer", "pk": 5137, "fields": { "question": 1034, "description": "We will head up to Scotland. The SNP is hanging by a thread and by prioritising Scotland on the final day, I’m sure we can turn many of those yellow seats blue. Let’s campaign side by side with Ruth Davidson on the last day." } }, { "model": "campaign_trail.answer", "pk": 5138, "fields": { "question": 1034, "description": "We will give one final speech in London. I am concerned about Labour’s potential to gain seats in our capital city, and we need to give them a push to stay blue." } }, { "model": "campaign_trail.answer", "pk": 5139, "fields": { "question": 1034, "description": "I will go to Dover with a beautiful backdrop of our famous White Cliffs and give a final speech about taking back control of our borders." } }, { "model": "campaign_trail.answer", "pk": 5140, "fields": { "question": 1035, "description": "This election is the most important in our lifetimes. The future of our economy, our country’s security, our trade, they’re all on the ballot today. As you go to the polls today, think deeply about who will provide the safer, more prosperous future for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5141, "fields": { "question": 1035, "description": "I am here today asking for your vote. I understand many of you have voted Labour all your lives, but consider the options. It’s a strong and stable government with the Conservatives, or a Coalition of Chaos with Jeremy Corbyn and the SNP." } }, { "model": "campaign_trail.answer", "pk": 5142, "fields": { "question": 1035, "description": "I began this campaign in Yorkshire, announcing my manifesto from the same county I am now finishing it in. The North of England holds our future, and it’s time to unlock it by providing us with a healthy majority to negotiate a deal that will ensure a prosperous future." } }, { "model": "campaign_trail.answer", "pk": 5143, "fields": { "question": 1035, "description": "The issues of today have never been more important than they are now. My Labour opponent wishes to scrap our Trident nuclear deterrent, rip us out of the NATO alliance, and allow foreign adversaries like Russia and China to prey on Britain. We can’t let that happen. Even if we disagree on some of the issues, we need a Conservative government to prevent the chaos of a Labour-SNP coalition." } }, { "model": "campaign_trail.answer", "pk": 5144, "fields": { "question": 1036, "description": "Fox hunting is out of the question. I stand by my point that it is an extremely unpopular policy and one that won’t help us win a strong Conservative majority in this election. If he wants to rebel against my government and join Jacob Rees-Mogg’s band of backbencher rebels, that’s his loss." } }, { "model": "campaign_trail.answer", "pk": 5145, "fields": { "question": 1036, "description": "The last thing we want in this election is party disunity, so after considering it further, I will give the party the vote on fox hunting, even though I was initially opposed to it. Matt Hancock has twisted my arm and I don’t want other Cabinet members following his lead." } }, { "model": "campaign_trail.answer", "pk": 5146, "fields": { "question": 1036, "description": "Fox hunting is off the table, but I can’t leave these vocal traditionalist MPs empty handed. As a compromise I will look to loosen the rules against new selective grammar schools and independently run free schools. I hope Matt Hancock appreciates that at least." } }, { "model": "campaign_trail.answer", "pk": 5147, "fields": { "question": 1036, "description": "This lady’s not for turning. We won’t backtrack on the fox hunting issue. However I will sweeten the pot with Matt Hancock and the strong right of the party through offering further tax and spending cuts in our 2017 party manifesto." } }, { "model": "campaign_trail.answer", "pk": 5148, "fields": { "question": 1037, "description": "We need to keep a balanced approach. The manifesto must be accessible to less educated voters, but we can’t be too eager to, for a lack of a better term, dumb down our material to the point we alienate our educated voters." } }, { "model": "campaign_trail.answer", "pk": 5149, "fields": { "question": 1037, "description": "This campaign is about reaching out. If we are to break down Labour’s “red wall” in the north, we need to ensure that our material is accessible to them. Brevity is the soul of wit, so let’s keep it short and straightforward. We should include many pictures where appropriate." } }, { "model": "campaign_trail.answer", "pk": 5150, "fields": { "question": 1037, "description": "We have a lot to mention, our proposed policies on many different components of Brexit, and of domestic policies, and I would like the manifesto to explain these thoroughly. I want our policies to be understood, even if the manifesto ends up being a little longer than originally intended." } }, { "model": "campaign_trail.answer", "pk": 5151, "fields": { "question": 1037, "description": "I will leave this to the party staffers, as I trust them to make the best decisions in regards to how we deliver the information in our manifesto." } }, { "model": "campaign_trail.answer", "pk": 5152, "fields": { "question": 1038, "description": "We need to keep a balanced approach. The manifesto must be accessible to less educated voters, but we can’t be too eager to, for a lack of a better term, dumb down our material to the point we alienate our educated voters." } }, { "model": "campaign_trail.answer", "pk": 5153, "fields": { "question": 1038, "description": "This campaign is about reaching out. If we are to break down Labour’s “red wall” in the north, we need to ensure that our material is accessible to them. Brevity is the soul of wit, so let’s keep it short and straightforward. We should include many pictures where appropriate." } }, { "model": "campaign_trail.answer", "pk": 5154, "fields": { "question": 1038, "description": "We have a lot to mention, our proposed policies on many different components of Brexit, and of domestic policies, and I would like the manifesto to explain these thoroughly. I want our policies to be understood, even if the manifesto ends up being a little longer than originally intended." } }, { "model": "campaign_trail.answer", "pk": 5155, "fields": { "question": 1038, "description": "I will leave this to the party staffers, as I trust them to make the best decisions in regards to how we deliver the information in our manifesto." } }, { "model": "campaign_trail.answer", "pk": 5156, "fields": { "question": 1039, "description": "We need to keep a balanced approach. The manifesto must be accessible to less educated voters, but we can’t be too eager to, for a lack of a better term, dumb down our material to the point we alienate our educated voters." } }, { "model": "campaign_trail.answer", "pk": 5157, "fields": { "question": 1039, "description": "This campaign is about reaching out. If we are to break down Labour’s “red wall” in the north, we need to ensure that our material is accessible to them. Brevity is the soul of wit, so let’s keep it short and straightforward. We should include many pictures where appropriate." } }, { "model": "campaign_trail.answer", "pk": 5158, "fields": { "question": 1039, "description": "We have a lot to mention, our proposed policies on many different components of Brexit, and of domestic policies, and I would like the manifesto to explain these thoroughly. I want our policies to be understood, even if the manifesto ends up being a little longer than originally intended." } }, { "model": "campaign_trail.answer", "pk": 5159, "fields": { "question": 1039, "description": "I will leave this to the party staffers, as I trust them to make the best decisions in regards to how we deliver the information in our manifesto." } }, { "model": "campaign_trail.answer", "pk": 5160, "fields": { "question": 1048, "description": "Let’s unveil it in the heart of our country, our capital city of London, home to 8 million people from many different backgrounds and beliefs, from our Bangladeshi communities in Tower Hamlets, to our Afro-Caribbean communities in places like Brixton, our message is we care about everyone. " } }, { "model": "campaign_trail.answer", "pk": 5161, "fields": { "question": 1049, "description": "Let’s unveil it in the education hub of our country, Oxford University. This is one of the most prestigious universities in not just the country, but the entire world. This is a campaign I want young and educated people to look positively at." } }, { "model": "campaign_trail.answer", "pk": 5162, "fields": { "question": 1050, "description": "Let’s unveil it up North in Yorkshire, where we will be able to make a stronger connection with the working class vote. This election isn’t like other elections, this time we have an actual chance to win these areas." } }, { "model": "campaign_trail.answer", "pk": 5163, "fields": { "question": 1047, "description": "Let’s unveil it up in Scotland, alongside Ruth Davidson, the popular leader of the Scottish Conservatives. Our strategy of asserting ourselves as the primary unionist opposition to the SNP could bear a lot of fruit." } }, { "model": "campaign_trail.answer", "pk": 5164, "fields": { "question": 1050, "description": "Let’s unveil it in the heart of our country, our capital city of London, home to 8 million people from many different backgrounds and beliefs, from our Bangladeshi communities in Tower Hamlets, to our Afro-Caribbean communities in places like Brixton, our message is we care about everyone. " } }, { "model": "campaign_trail.answer", "pk": 5165, "fields": { "question": 1050, "description": "Let’s unveil it in the education hub of our country, Oxford University. This is one of the most prestigious universities in not just the country, but the entire world. This is a campaign I want young and educated people to look positively at." } }, { "model": "campaign_trail.answer", "pk": 5166, "fields": { "question": 1049, "description": "Let’s unveil it up North in Yorkshire, where we will be able to make a stronger connection with the working class vote. This election isn’t like other elections, this time we have an actual chance to win these areas." } }, { "model": "campaign_trail.answer", "pk": 5167, "fields": { "question": 1042, "description": "Let’s unveil it up in Scotland, alongside Ruth Davidson, the popular leader of the Scottish Conservatives. Our strategy of asserting ourselves as the primary unionist opposition to the SNP could bear a lot of fruit." } }, { "model": "campaign_trail.answer", "pk": 5168, "fields": { "question": 1051, "description": "David Davis should throw some attacks towards the Liberal Democrats. If they had it their way, they’d scrap Article 50 and betray the 2016 decision the British people made to leave the European Union." } }, { "model": "campaign_trail.answer", "pk": 5169, "fields": { "question": 1051, "description": "David Davis should direct attacks against UKIP. We are getting out of the EU in my next term I can assure that, but we can’t have a mainstream party who campaigns on hate and xenophobia. Paul Nuttall called for a war against “cultural Marxists”, This hateful, antisemitic language is unacceptable." } }, { "model": "campaign_trail.answer", "pk": 5170, "fields": { "question": 1051, "description": "As the governing party we must be prepared to be attacked from every direction. David Davis will be pressed into the defending position, and we must ensure he’s able to respond effectively to every argument that gets thrown at him." } }, { "model": "campaign_trail.answer", "pk": 5171, "fields": { "question": 1051, "description": "David Davis should keep this a two horse race. Our target is the Labour party." } }, { "model": "campaign_trail.answer", "pk": 5172, "fields": { "question": 1052, "description": "Philip Hammond should throw some attacks towards the Liberal Democrats. If they had it their way, they’d scrap Article 50 and betray the 2016 decision the British people made to leave the European Union." } }, { "model": "campaign_trail.answer", "pk": 5173, "fields": { "question": 1052, "description": "Philip Hammond should direct attacks against UKIP. We are getting out of the EU in my next term I can assure that, but we can’t have a mainstream party who campaigns on hate and xenophobia. Paul Nuttall called for a war against “cultural Marxists”, This hateful, antisemitic language is unacceptable." } }, { "model": "campaign_trail.answer", "pk": 5174, "fields": { "question": 1052, "description": "As the governing party we must be prepared to be attacked from every direction. Philip Hammond will be pressed into the defending position, and we must ensure he’s able to respond effectively to every argument that gets thrown at him." } }, { "model": "campaign_trail.answer", "pk": 5175, "fields": { "question": 1052, "description": "Philip Hammond should keep this a two horse race. Our target is the Labour party." } }, { "model": "campaign_trail.answer", "pk": 5176, "fields": { "question": 1053, "description": "I will throw some attacks towards the Liberal Democrats. If they had it their way, they’d scrap Article 50 and betray the 2016 decision the British people made to leave the European Union." } }, { "model": "campaign_trail.answer", "pk": 5177, "fields": { "question": 1053, "description": "I will direct attacks against UKIP. We are getting out of the EU in my next term I can assure that, but we can’t have a mainstream party who campaigns on hate and xenophobia. Paul Nuttall called for a war against “cultural Marxists”, This hateful, antisemitic language is unacceptable." } }, { "model": "campaign_trail.answer", "pk": 5178, "fields": { "question": 1053, "description": "As the governing party we must be prepared to be attacked from every direction. I will be pressed into the defending position, and I must ensure I’m able to respond effectively to every argument that gets thrown my direction." } }, { "model": "campaign_trail.answer", "pk": 5179, "fields": { "question": 1053, "description": "We should keep this a two horse race. Our target is the Labour party." } }, { "model": "campaign_trail.answer", "pk": 5180, "fields": { "question": 1054, "description": "Remain calm and composed. Stay in control, present strength and stability. We will dismantle Jeremy Corbyn in a refined, controlled manner." } }, { "model": "campaign_trail.answer", "pk": 5181, "fields": { "question": 1054, "description": "Go on the attack. Corbyn has many vulnerabilities that we can take advantage of. Let’s hammer hard on those." } }, { "model": "campaign_trail.answer", "pk": 5182, "fields": { "question": 1054, "description": "We need to make sure I can be more relatable. I will try to avoid using language that can be too academic, in order to be more relatable to working class voters." } }, { "model": "campaign_trail.answer", "pk": 5183, "fields": { "question": 1054, "description": "You know what, I will listen to my strategists and advisers for how I should debate Corbyn. The stakes are too high for me to potentially make a catastrophic mistake." } }, { "model": "campaign_trail.answer", "pk": 5184, "fields": { "question": 1055, "description": "Remain calm and composed. Stay in control, present strength and stability. We will dismantle Jeremy Corbyn in a refined, controlled manner." } }, { "model": "campaign_trail.answer", "pk": 5185, "fields": { "question": 1055, "description": "Go on the attack. Corbyn has many vulnerabilities that we can take advantage of. Let’s hammer hard on those." } }, { "model": "campaign_trail.answer", "pk": 5186, "fields": { "question": 1055, "description": "We need to make sure I can be more relatable. I will try to avoid using language that can be too academic, in order to be more relatable to working class voters." } }, { "model": "campaign_trail.answer", "pk": 5187, "fields": { "question": 1055, "description": "You know what, I will listen to my strategists and advisers for how I should debate Corbyn. The stakes are too high for me to potentially make a catastrophic mistake." } }, { "model": "campaign_trail.answer", "pk": 5188, "fields": { "question": 1056, "description": "Remain calm and composed. Stay in control, present strength and stability. We will dismantle Jeremy Corbyn in a refined, controlled manner." } }, { "model": "campaign_trail.answer", "pk": 5189, "fields": { "question": 1056, "description": "Go on the attack. Corbyn has many vulnerabilities that we can take advantage of. Let’s hammer hard on those." } }, { "model": "campaign_trail.answer", "pk": 5190, "fields": { "question": 1056, "description": "We need to make sure I can be more relatable. I will try to avoid using language that can be too academic, in order to be more relatable to working class voters." } }, { "model": "campaign_trail.answer", "pk": 5191, "fields": { "question": 1056, "description": "You know what, I will listen to my strategists and advisers for how I should debate Corbyn. The stakes are too high for me to potentially make a catastrophic mistake." } }, { "model": "campaign_trail.answer", "pk": 5192, "fields": { "question": 1057, "description": "This election is the most important in our lifetimes. The future of our economy, our country’s security, our trade, they’re all on the ballot today. As you go to the polls today, think deeply about who will provide the safer, more prosperous future for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5193, "fields": { "question": 1057, "description": "We are here today, asking for your vote. If you’re opposed to Scotland crashing out of our united Kingdom, the Conservative and Unionist Party is the only party which will stand up against the excesses of Nicola Sturgeon and the SNP. No IndyRef 2!" } }, { "model": "campaign_trail.answer", "pk": 5194, "fields": { "question": 1057, "description": "Scotland has been left in the dark by Nicola Sturgeon and the SNP, and the only ones who are willing to make the steps to bring Scotland a new level of prosperity are the Conservatives, who will invest in our small Scottish businesses, and bring growth to the country." } }, { "model": "campaign_trail.answer", "pk": 5195, "fields": { "question": 1057, "description": "The issues of today have never been more important than they are now. Even if we disagree on some of the issues, we need a Conservative government to prevent the chaos of a Labour-SNP coalition. Labour will scrap Trident and leave us vulnerable on the world stage. Only a vote for the Conservatives can stop this." } }, { "model": "campaign_trail.answer", "pk": 5196, "fields": { "question": 1058, "description": "This election is the most important in our lifetimes. The future of our economy, our country’s security, our trade, they’re all on the ballot today. As you go to the polls today, think deeply about who will provide the safer, more prosperous future for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5197, "fields": { "question": 1058, "description": "I am here today asking for your vote. The allure of Jeremy Corbyn’s siren song may be enticing, but consider the options. It’s a sensible, strong and stable government with the Conservatives, or a Coalition of Chaos with Jeremy Corbyn and the SNP." } }, { "model": "campaign_trail.answer", "pk": 5198, "fields": { "question": 1058, "description": "The Conservatives are the party of growth, the party of innovation, the party of enterprise and the party which stands for our small businesses. We believe in a country where people can succeed, and are not punished for their success. Jeremy Corbyn and Labour reward laziness. The Conservatives reward hard work." } }, { "model": "campaign_trail.answer", "pk": 5199, "fields": { "question": 1058, "description": "The issues of today have never been more important than they are now. My Labour opponent wishes to scrap our Trident nuclear deterrent, rip us out of the NATO alliance, and allow foreign adversaries like Russia and China to prey on Britain. We can’t let that happen. Even if we disagree on some of the issues, we need a Conservative government to prevent the chaos of a Labour-SNP coalition." } }, { "model": "campaign_trail.answer", "pk": 5200, "fields": { "question": 1059, "description": "This election is the most important in our lifetimes. The future of our economy, our country’s security, our trade, our border, they’re all on the ballot today. As you go to the polls today, think deeply about who will provide the safer, more prosperous future for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5201, "fields": { "question": 1059, "description": "Dover represents the gateway to our country, where migrants hide in lorries to get into our country illegally. In 2016, we voted to leave the European Union to stop the flood of illegals into our country, and by voting Conservative you can give us a majority that can secure our country, and allow us to take back our borders from Brussels." } }, { "model": "campaign_trail.answer", "pk": 5202, "fields": { "question": 1059, "description": "Places like Dover represent our coastal towns deprived by legislation from Brussels. Now we’re on the path to leaving and freeing our economy from the claws of EU bureaucrats, to be able to fish in our own waters, to free British farmers from Brussels red tape. A Conservative majority will raise our standings to negotiate the best deal for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5203, "fields": { "question": 1059, "description": "Ultimately, this election comes down to the issue of security. The 2016 vote was a vote to give Britain the sovereignty to exercise its right to security. A strong Conservative majority will strengthen our border, we will crack down on terrorist organising, we will ensure that you and your family thrive in a safe, strong, and stable country." } }, { "model": "campaign_trail.answer", "pk": 5204, "fields": { "question": 1060, "description": "You’re not willing to throw this country to Corbyn’s Coalition of Chaos this readily, are you? I understand that many are frustrated, but we must remember that the only realistic option for a strong and stable future is a Conservative majority able to negotiate a strong deal for you and your family." } }, { "model": "campaign_trail.answer", "pk": 5205, "fields": { "question": 1060, "description": "This is very worrying. We have to soften the roughest edges of our Brexit policy. I will rule out the no-deal option completely and promise a smooth transition from EU membership to independence." } }, { "model": "campaign_trail.answer", "pk": 5206, "fields": { "question": 1060, "description": "I’m not worried, most of these Remain-leaning seats are deeply within strong Conservative majorities. For every Remain voter we lose, we pick up three Leave voters in marginal constituencies. You can’t please everyone in politics, we must make difficult choices." } }, { "model": "campaign_trail.answer", "pk": 5207, "fields": { "question": 1060, "description": "We must stay the course on our Brexit plans in order to avoid alienating the voters we’re projected to gain in this election. We instead will have to look for compromises elsewhere we can make to keep these voters on board." } }, { "model": "campaign_trail.answer", "pk": 5208, "fields": { "question": 1061, "description": "The hype will wear off soon. The fact that Nigel Farage wants to spoil this election for Jeremy Corbyn and his Coalition of Chaos with the SNP is the main story here. We will reassure people of the facts in this election. It’s a strong and stable Conservative majority, or it’s chaos and disorder under Jeremy Corbyn." } }, { "model": "campaign_trail.answer", "pk": 5209, "fields": { "question": 1061, "description": "We need to snuff Farage out immediately. We need our campaign to investigate UKIP and Farage thoroughly to find some scandals that can derail them." } }, { "model": "campaign_trail.answer", "pk": 5210, "fields": { "question": 1061, "description": "Oh… oh dear, that won’t do at all. We have to reverse this trend as soon as possible. Let’s take a strong stance on issues that appeal to 2016 Leave voters like immigration and national sovereignty. We can’t let Farage take away our voters." } }, { "model": "campaign_trail.answer", "pk": 5211, "fields": { "question": 1061, "description": "We are in a difficult spot in this election, where we can’t satisfy two different coalitions of voters, but we have to try our best and balance things out. Let’s make some steps towards trying to reign in the Hard Brexit wing, which is threatening to desert me, but not too much to the point I alienate Soft Brexiteers." } }, { "model": "campaign_trail.answer", "pk": 5212, "fields": { "question": 1062, "description": "This makes me wonder if we can pick up some Labour seats in London. The trends to Conservatives between 2015 and 2017 do show the strongest trends in the Leave voting Red Wall, but with our unexpectedly strong prospects in London, I wonder if we can win seats like Westminster North or Harrow West from Labour." } }, { "model": "campaign_trail.answer", "pk": 5213, "fields": { "question": 1062, "description": "Oh, that’s great news to hear. Let’s head back up to Scotland for a bit, and push the Conservatives as the leading opposition to the SNP, advocating our strong stances on British unionism." } }, { "model": "campaign_trail.answer", "pk": 5214, "fields": { "question": 1062, "description": "Whilst that’s great news to hear, we can’t get complacent. The only way we’re going to win the Red Wall seats in great numbers is to target our effort towards them. Let’s organise some campaign events in some target seats around the Red Wall, like Dewsbury and Birmingham Northfield." } }, { "model": "campaign_trail.answer", "pk": 5215, "fields": { "question": 1062, "description": "We may be doing well now, but we can never take our support for granted. This does indicate a comparative weakness with Leave supporters in the Red Wall, but as we organise events to appeal to them, we can’t neglect this appeal that the polls suggest we have. Let’s try to strike a middle ground." } }, { "model": "campaign_trail.answer", "pk": 5216, "fields": { "question": 1063, "description": "Oh, oh my… What kind of support are we talking about here? We’re talking about swinging seats that are 20+ points in the Labour column to the Conservatives? Well, if we could swing those, we could have a very strong majority. Let’s target some of these seats. They may be an uphill battle, but now I fully believe we can win them." } }, { "model": "campaign_trail.answer", "pk": 5217, "fields": { "question": 1063, "description": "Well, we can’t deny that things are going well, but we can't shift our focus. Our goal is to win a majority in the safest way we can, so let’s continue our focus on the vulnerable Red Wall seats we originally placed at the top of our list." } }, { "model": "campaign_trail.answer", "pk": 5218, "fields": { "question": 1063, "description": "That’s great to hear, but it does indicate we could be doing better with Remain voters, which we should be able to do. We just have to make sure we don’t alienate Leave supporters that we're doing well with according to our internal polling." } }, { "model": "campaign_trail.answer", "pk": 5219, "fields": { "question": 1063, "description": "That’s great to hear that our plans are working. We’ll continue with our current path whilst keeping in mind other seats we need to win, like our target seats in Scotland." } }, { "model": "campaign_trail.answer", "pk": 5220, "fields": { "question": 1064, "description": "We need to win these seats somehow, and if we don’t at least give the appearance of compromise with some of their more left-leaning economic values, we risk being shut out of these seats altogether. Let’s arrange more events and promise investment into our left-behind communities." } }, { "model": "campaign_trail.answer", "pk": 5221, "fields": { "question": 1064, "description": "The Red Wall is complex in their ideology, and it isn’t just backed by their economic stances. Our social policies are far closer to the average Red Wall voter than Labour’s are, so let’s use this to our advantage. Let’s run our campaign by promising to be tough on crime and hardening our border." } }, { "model": "campaign_trail.answer", "pk": 5222, "fields": { "question": 1064, "description": "What do you mean? The voters in the Red Wall like free handouts for those who are too lazy to work? I’m sure our working class respects work, not the work-shy and benefits fraudsters who are exploiting the system. We need to reform our benefits system to change this." } }, { "model": "campaign_trail.answer", "pk": 5223, "fields": { "question": 1064, "description": "We have to change this immediately. Let’s take a moderate left-leaning stance into the ground that Corbyn has alienated. We’ll poach some passages from earlier Labour manifestos that provide a left-leaning, but sensible alternative to Corbyn’s madness." } }, { "model": "campaign_trail.answer", "pk": 5224, "fields": { "question": 1065, "description": "A strong election campaign needs some compromises to be made, and I am surprised that these MPs don’t see the necessity of that to win these Red Wall seats. Let’s continue with our current plan to win this election with a strong and stable majority." } }, { "model": "campaign_trail.answer", "pk": 5225, "fields": { "question": 1065, "description": "Are you kidding me right now? These MPs would rather have Jeremy Corbyn’s hard-left socialism than sensible governance by the Conservatives? You don’t undermine your own side at the risk of something even worse winning. I’m shocked by this." } }, { "model": "campaign_trail.answer", "pk": 5226, "fields": { "question": 1065, "description": "Oh dear, we need a united party. What can I do for these MPs that will get them off my back? Okay, we’ll promise additional measures to cut taxes and reign in government spending. That should do the trick." } }, { "model": "campaign_trail.answer", "pk": 5227, "fields": { "question": 1065, "description": "Let’s promise them a tax cut, but we can’t go overboard with increasing austerity. It’s way too unpopular with the majority of the country. Just a small package to get these MPs off my back, and then continue our campaign in our target seats." } }, { "model": "campaign_trail.answer", "pk": 5228, "fields": { "question": 1066, "description": "This is good for us, as it will help us appeal to Red Wall voters and swing our target seats from red to blue. Let’s take advantage of this and strengthen our campaign in the Red Wall." } }, { "model": "campaign_trail.answer", "pk": 5229, "fields": { "question": 1066, "description": "Hmm… How strong is this uneasy satisfaction that I’m hearing about? There’s a chance they could fall out from under us, and we need to ensure they don’t. Let’s promise a tax cut to prevent that possibility." } }, { "model": "campaign_trail.answer", "pk": 5230, "fields": { "question": 1066, "description": "That’s all good to hear that our current approach is going well. If it isn’t broken, don’t fix it? We’ll continue our current strategy." } }, { "model": "campaign_trail.answer", "pk": 5231, "fields": { "question": 1066, "description": "This is good for us, as it broadens our appeal across many groups, not just the Red Wall. It will also help us in Scotland, so let’s take advantage of that, we’ll meet up with Ruth Davidson and do some campaign stops in Scotland." } }, { "model": "campaign_trail.answer", "pk": 5232, "fields": { "question": 1067, "description": "Knowing we have a unified party at the moment is good, we don’t have to worry about a walk-out from the hard-right faction. Since we know they’re stable, we can turn our attention towards moderating our economic positions a little to improve our appeal to the Red Wall." } }, { "model": "campaign_trail.answer", "pk": 5233, "fields": { "question": 1067, "description": "Knowing we have a unified party is good, so we can take advantage of this by getting our MPs to campaign alongside some of our most prospective candidates. Let’s show a unified effort and get the majority we need for the negotiations with Brussels." } }, { "model": "campaign_trail.answer", "pk": 5234, "fields": { "question": 1067, "description": "I hope this support from our party is strong enough not to concern myself with a walk-out at this crucial time. I believe we’re safe enough to make a strong play into the centre-left to attract Red Wall voters who are uneasy about Jeremy Corbyn’s far-left nonsense." } }, { "model": "campaign_trail.answer", "pk": 5235, "fields": { "question": 1067, "description": "We will continue to campaign the way we are currently, and whatever happens, happens." } }, { "model": "campaign_trail.answer", "pk": 5236, "fields": { "question": 1068, "description": "The world has been getting more dangerous. The worst terrorist attack in the Western world since 9/11 occurred in Paris a year and a half ago. We saw another severe attack in Nice, and this campaign has experienced two terrorist attacks. We can’t do nothing, something must be done." } }, { "model": "campaign_trail.answer", "pk": 5237, "fields": { "question": 1068, "description": "Do these people want more incidents like the Lee Rigby murder in 2013? Do they want our country to be the victim of even more radical Islamist terrorism? We need this policy to keep Britain safe from further attacks." } }, { "model": "campaign_trail.answer", "pk": 5238, "fields": { "question": 1068, "description": "Okay, I get it, this policy is unpopular. We’ll scale the plan back and instead promise an increase to the size of Britain’s police forces to compensate. We aim for 20,000 additional officers on the streets to keep Britons safe. In our next term, we promise the greatest increase to our policing budget ever." } }, { "model": "campaign_trail.answer", "pk": 5239, "fields": { "question": 1068, "description": "I’ve realised that this is a controversial policy that divides the party, so we’ll have to consider how to mitigate its effects. I won’t remove the idea completely, but I might consider strengthening the criteria for warrants to be issued for monitoring groups under this new programme." } }, { "model": "campaign_trail.answer", "pk": 5240, "fields": { "question": 1069, "description": "Oh no, no. That won’t do at all, we must change the image on the issue immediately. Let’s do some photo ops of me dressed up as a police officer standing beside police during the arrest of a suspected terrorist." } }, { "model": "campaign_trail.answer", "pk": 5241, "fields": { "question": 1069, "description": "Oh dear, that doesn’t look good for us at all. We have to do something big to change the story. Let’s promise a massive increase in police funding and an additional 20,000 police officers on our streets, the greatest increase in history to police funding." } }, { "model": "campaign_trail.answer", "pk": 5242, "fields": { "question": 1069, "description": "I question the effectiveness of this legislation to spy on the internet that some of my advisers have been suggesting, but I think I see where they’re coming from now. I was concerned about the privacy questions, but now I see that something needs to be done. I will revive this policy to change my image on these issues." } }, { "model": "campaign_trail.answer", "pk": 5243, "fields": { "question": 1069, "description": "Do you think Jeremy Corbyn and his band of far-left socialists will be any better on the issues of national security and counterterrorism? The only answer is a Conservative government that will be able to negotiate a deal that will protect our borders and make Britain safer." } }, { "model": "campaign_trail.answer", "pk": 5244, "fields": { "question": 1070, "description": "Right, yes. I don’t believe in infringing on the right to privacy, and that’s why I couldn’t with a good conscience advocate that idea. I understand that people are concerned about increased rates of terrorist violence, and we will look for alternative methods to solve it, like increasing our police funding and strengthening the Prevent programme." } }, { "model": "campaign_trail.answer", "pk": 5245, "fields": { "question": 1070, "description": "With the increased rates of terrorist violence in our modern world, I must consider reviving the internet surveillance plans that have been developed. However, we will ensure that there’s a warrant for searching before any action is taken under the policy." } }, { "model": "campaign_trail.answer", "pk": 5246, "fields": { "question": 1070, "description": "It’s good they’re happy with us, but that doesn’t mean other voters who care more about their safety are happy with us. I’ve thought long and hard about it, but have decided to go along with the party’s proposal for a more comprehensive internet surveillance programme." } }, { "model": "campaign_trail.answer", "pk": 5247, "fields": { "question": 1070, "description": "As long as I’m Prime Minister, that plan won’t see the light of day, don’t you worry about that. Our plans for counter-terrorism will involve a massive increase in police funding, an additional 20,000 officers on our streets, the greatest increase in history to police funding." } }, { "model": "campaign_trail.answer", "pk": 5248, "fields": { "question": 1071, "description": "We are doing what is necessary to keep Britain safe in a more dangerous world, and I am happy people see that. Let’s continue with our current strategy." } }, { "model": "campaign_trail.answer", "pk": 5249, "fields": { "question": 1071, "description": "For now, this is the right pathway, but we must remain adaptable to changing circumstances. If terrorist action continues to grow as a threat, we must consider the possibility of even stronger legislation in the future against this menace." } }, { "model": "campaign_trail.answer", "pk": 5250, "fields": { "question": 1071, "description": "We have to strike a balance on this issue, by ensuring we respect the right to privacy of British citizens, but at the same time, reducing the rate of terrorist violence within our country. I will keep our plans in place to monitor the internet, but I will make the use of this Act subject to a warrant." } }, { "model": "campaign_trail.answer", "pk": 5251, "fields": { "question": 1071, "description": "My perception is of being capable of reducing the terrorist violence in my next term, and that’s good to see. However, we must also be more tender when the situation calls for it too. I will retain the plan to monitor the internet, but look to reform and de-radicalise suspected terrorists through the Prevent programme, which will receive additional funding in my next term." } }, { "model": "campaign_trail.answer", "pk": 5252, "fields": { "question": 1072, "description": "We’ll lean slightly into some more progressive policies to nullify this. We have to ensure we can perform well in London and Scotland." } }, { "model": "campaign_trail.answer", "pk": 5253, "fields": { "question": 1072, "description": "We will stay the course. We don’t believe social issues will make too much of a difference, and we’re better suited to appeal to these regions on a Soft Brexit platform." } }, { "m