    },
    {
        "model": "campaign_trail.answer_feedback",
        "pk": 2528,
        "fields": {
            "answer": 5022,
            "candidate": 200,
            "answer_feedback": "It’s expected that this manifesto will play best in London and the Home Countries, where there are more educated voters."
        }
    },
    {
