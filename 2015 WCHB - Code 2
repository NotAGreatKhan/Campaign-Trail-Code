    },
    {
        "model": "campaign_trail.answer_feedback",
        "pk": 2531,
        "fields": {
            "answer": 5025,
            "candidate": 200,
            "answer_feedback": "You hurl a slew of attacks at your main opposition in this race. This is often unwise when you’re well ahead in the polls, but as the momentum is starting to pick up for your opponent, maybe breaking orthodoxy is a good idea here?"
