function addWindowButton() {
    // Check if the button already exists
    if (document.getElementById('window_button')) {
        return;
    }

    // Find the reference button by its ID
    const refButton = document.getElementById('view_electoral_map');
    if (!refButton) {
        return;
    }

    // Create a new button element
    const newButton = document.createElement('button');

    newButton.id = 'window_button';

    newButton.style.marginLeft = '1.5em';

    newButton.innerHTML = 'Our Standing';

    // Attach the click event listener
    newButton.addEventListener('click', openSurrogates);

    // Insert the new button next to the reference button
    refButton.insertAdjacentElement('afterend', newButton);
}

function removeById(arr, id) {
  const index = arr.findIndex(item => item.id === id);
  if (index !== -1) arr.splice(index, 1);
  refreshSurrogates()
}

function replaceById(arr, id, newItem) {
  const index = arr.findIndex(item => item.id === id);
  if (index !== -1) arr.splice(index, 1, newItem);
  refreshSurrogates();

}

function insertAt(arr, index, newItem) {
  arr.splice(index, 0, newItem);
  refreshSurrogates();
}

