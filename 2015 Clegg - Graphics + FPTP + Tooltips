      closestOpponent = {
          name: "Donald Trump Jr.",
          picture: "https://itsastronomical.com/assets/2024/opp/donjr.png",
          advice: "Donald Trump's namesake. But not his first choice for Crown Prince."
      };
  }

  return closestOpponent;
