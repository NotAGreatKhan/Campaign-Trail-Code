    {
        "model": "campaign_trail.question",
        "pk": 12906,
        "fields": {
            "priority": 0,
            "description": "Today, you have been scheduled to go on the Jeremy Paxman Interview, along with Howard and Kennedy later this month. The pressure is certainly going to be on you in the responses. So with all of that said. How will you approach the tone of this interview?",
            "likelihood": 1
