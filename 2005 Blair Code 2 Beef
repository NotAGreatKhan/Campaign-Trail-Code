    {
        "model": "campaign_trail.question",
        "pk": 12836,
        "fields": {
            "priority": 0,
            "description": "Another long day, another plate of dinner finally cleaned off. You receive yet another phone call – was it the 25th of the day? You’re barely sure yourself. But this time, this time it’s special. The results of the local elections are in, and it’s a major blow for Labour. This is a bad preview for the general election, whenever you decide to call it. How do you react to this series of events?",
            "likelihood": 1
