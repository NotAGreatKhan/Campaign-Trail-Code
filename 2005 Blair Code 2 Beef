    {
        "model": "campaign_trail.question",
        "pk": 13117,
        "fields": {
            "priority": 0,
            "description": "It’s nearly over, this election season. The starry eyes of devotees don't sparkle at you like they did in years past. Tony Blair, the embodiment of Cool Britannia, the reformist who revolutionised Labour – the people don't see it as you do anymore. Even still, it is finally time to hammer home your final message. What focus group shall you pander to, to convince the voters to vote for you this Spring?",
            "likelihood": 1
        }
